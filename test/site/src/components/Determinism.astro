---
import SectionHead from "./SectionHead.astro";
---

<section class="section wrap" id="demo">
  <SectionHead title="Determinism" description="Same seed. Same bytes. Every time." />

  <div class="tile-grid det-grid" data-reveal style="--reveal-i:1">
    <div class="tile det-tile">
      <span class="tile__spotlight" aria-hidden="true"></span>
      <div class="tile__avatar" style="--avatar-size:72px" data-det-slot="1"></div>
      <div class="tile__label">bolota() #1</div>
    </div>
    <div class="tile det-tile">
      <span class="tile__spotlight" aria-hidden="true"></span>
      <div class="tile__avatar" style="--avatar-size:72px" data-det-slot="2"></div>
      <div class="tile__label">bolota() #2</div>
    </div>
    <div class="tile det-tile">
      <span class="tile__spotlight" aria-hidden="true"></span>
      <div class="tile__avatar" style="--avatar-size:72px" data-det-slot="3"></div>
      <div class="tile__label">parts() adapter</div>
    </div>
  </div>

  <div class="det-status-row" data-reveal style="--reveal-i:2">
    <div class="det-status" data-det-status>checking…</div>
    <div class="det-status" data-det-norm>normalizeSeed…</div>
  </div>
</section>
