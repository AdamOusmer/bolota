---
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "bolota, one string, one face, forever",
  description = "Deterministic SVG avatars from any string, with a motion engine for when they need to move. A Luzir project.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The one deliberate exception to "every color is a var(--token) from
// tokens.css": a `data:` URI favicon is resolved by the browser before the
// page's own stylesheet exists, so it cannot reference a CSS custom
// property. These two hex values are --bg-color and --light from
// tokens.css, named here (not inlined below) so there is exactly one place
// to update them by hand if those tokens ever change.
const FAVICON_BG = "#262730"; // tokens.css --bg-color
const FAVICON_ACCENT = "#e8b34d"; // tokens.css --light
const favicon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='${FAVICON_BG.replace("#", "%23")}'/%3E%3Crect x='5' y='5' width='14' height='14' rx='3' fill='${FAVICON_ACCENT.replace("#", "%23")}'/%3E%3C/svg%3E`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="bolota" />
    <link rel="icon" href={favicon} />
    <!-- [data-reveal]'s resting state is opacity: 0 until src/scripts/lib/
         motion.ts's setupReveal() (or, under prefers-reduced-motion, its
         own reduced-motion branch) runs; this is the fallback for when JS
         never runs at all, so content never gets stuck invisible. -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div data-nav-sentinel aria-hidden="true" style="position:absolute; top:0; left:0; width:1px; height:1px;"></div>
    <div class="lightfield" data-lightfield aria-hidden="true">
      <canvas class="lightfield__motes" data-motes></canvas>
      <div class="lightfield__torch"></div>
      <div class="lightfield__grain"></div>
    </div>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
