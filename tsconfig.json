{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    // Framework-agnostic library: no JSX anywhere in this repo, so no
    // `react` type entry point to resolve (this used to be a workspace
    // member sharing a root config with JSX-using apps; those are gone).
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "scripts"],
  // web/ is a separate Astro app with its own tsconfig (Bundler
  // resolution against the published `blobatar` package, DOM libs for the
  // browser entry point). It is not part of the library's type surface —
  // let its own job in CI type-check/build it instead.
  "exclude": ["dist", "node_modules", "web"]
}
