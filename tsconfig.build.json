{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // Off, not true: a declaration map's `sources` point at `../src/*.ts`,
    // and the publish `files` list (package.json) ships `dist` only — no
    // `src` — so a `.d.ts.map` in the tarball would dangle, pointing a
    // consumer's "go to definition" at a path that does not exist in their
    // node_modules. `declaration` alone is everything type resolution needs.
    "declarationMap": false,
    // Empty, overriding the root config's ["bun"]: this project only compiles
    // `src`, which uses no Bun globals (they live in `test` and `scripts`), so
    // requiring @types/bun here made the declaration emit fail wherever dev
    // dependencies are pruned. A deploy host that sets NODE_ENV=production
    // gets a devDependency-free install, and the build died on a type package
    // the output never needed.
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
